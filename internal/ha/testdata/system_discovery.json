{
  "avty": [
    {
      "t": "felicity/availability"
    }
  ],
  "avty_mode": "all",
  "cmps": {
    "felicity_system_bus_errors": {
      "ent_cat": "diagnostic",
      "ic": "mdi:alert-circle-outline",
      "name": "Bus errors",
      "p": "sensor",
      "stat_cla": "total_increasing",
      "sug_dsp_prc": 0,
      "uniq_id": "felicity_system_bus_errors",
      "val_tpl": "{{ value_json.bus_errors }}"
    },
    "felicity_system_capacity_ah": {
      "ic": "mdi:battery-high",
      "name": "Full charge capacity",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_capacity_ah",
      "unit_of_meas": "Ah",
      "val_tpl": "{{ value_json.capacity_ah }}"
    },
    "felicity_system_cell_delta_mv": {
      "dev_cla": "voltage",
      "ent_cat": "diagnostic",
      "name": "Cell voltage delta",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 0,
      "uniq_id": "felicity_system_cell_delta_mv",
      "unit_of_meas": "mV",
      "val_tpl": "{{ value_json.cell_delta_mv }}"
    },
    "felicity_system_cell_max": {
      "dev_cla": "voltage",
      "ent_cat": "diagnostic",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'pack': value_json.cell_max_pack, 'cell': value_json.cell_max_index} | tojson }}",
      "name": "Cell voltage max",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 3,
      "uniq_id": "felicity_system_cell_max",
      "unit_of_meas": "V",
      "val_tpl": "{{ value_json.cell_max }}"
    },
    "felicity_system_cell_min": {
      "dev_cla": "voltage",
      "ent_cat": "diagnostic",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'pack': value_json.cell_min_pack, 'cell': value_json.cell_min_index} | tojson }}",
      "name": "Cell voltage min",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 3,
      "uniq_id": "felicity_system_cell_min",
      "unit_of_meas": "V",
      "val_tpl": "{{ value_json.cell_min }}"
    },
    "felicity_system_charge_current_limit": {
      "dev_cla": "current",
      "name": "Charge current limit",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_charge_current_limit",
      "unit_of_meas": "A",
      "val_tpl": "{{ value_json.charge_current_limit }}"
    },
    "felicity_system_charge_enabled": {
      "ent_cat": "diagnostic",
      "ic": "mdi:battery-arrow-up",
      "name": "Charge enabled",
      "p": "binary_sensor",
      "uniq_id": "felicity_system_charge_enabled",
      "val_tpl": "{{ 'ON' if value_json.charge_enabled else 'OFF' }}"
    },
    "felicity_system_charge_immediately": {
      "ent_cat": "diagnostic",
      "ic": "mdi:battery-alert",
      "name": "Charge immediately request",
      "p": "binary_sensor",
      "uniq_id": "felicity_system_charge_immediately",
      "val_tpl": "{{ 'ON' if value_json.charge_immediately else 'OFF' }}"
    },
    "felicity_system_charge_voltage_limit": {
      "dev_cla": "voltage",
      "name": "Charge voltage limit",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_charge_voltage_limit",
      "unit_of_meas": "V",
      "val_tpl": "{{ value_json.charge_voltage_limit }}"
    },
    "felicity_system_charging": {
      "dev_cla": "battery_charging",
      "name": "Charging",
      "p": "binary_sensor",
      "uniq_id": "felicity_system_charging",
      "val_tpl": "{{ 'ON' if value_json.charging else 'OFF' }}"
    },
    "felicity_system_current": {
      "dev_cla": "current",
      "name": "Current",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_current",
      "unit_of_meas": "A",
      "val_tpl": "{{ value_json.current }}"
    },
    "felicity_system_discharge_current_limit": {
      "dev_cla": "current",
      "name": "Discharge current limit",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_discharge_current_limit",
      "unit_of_meas": "A",
      "val_tpl": "{{ value_json.discharge_current_limit }}"
    },
    "felicity_system_discharge_enabled": {
      "ent_cat": "diagnostic",
      "ic": "mdi:battery-arrow-down",
      "name": "Discharge enabled",
      "p": "binary_sensor",
      "uniq_id": "felicity_system_discharge_enabled",
      "val_tpl": "{{ 'ON' if value_json.discharge_enabled else 'OFF' }}"
    },
    "felicity_system_discharge_voltage_limit": {
      "dev_cla": "voltage",
      "name": "Discharge voltage limit",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_discharge_voltage_limit",
      "unit_of_meas": "V",
      "val_tpl": "{{ value_json.discharge_voltage_limit }}"
    },
    "felicity_system_packs_online": {
      "ent_cat": "diagnostic",
      "ic": "mdi:battery-sync",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'online': value_json.packs_online, 'configured': value_json.packs_configured} | tojson }}",
      "name": "Packs online",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 0,
      "uniq_id": "felicity_system_packs_online",
      "val_tpl": "{{ value_json.packs_online_count }}"
    },
    "felicity_system_power": {
      "dev_cla": "power",
      "name": "Power",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 0,
      "uniq_id": "felicity_system_power",
      "unit_of_meas": "W",
      "val_tpl": "{{ value_json.power }}"
    },
    "felicity_system_problem": {
      "dev_cla": "problem",
      "ent_cat": "diagnostic",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'alarm_flags': value_json.alarm_flags, 'packs_online': value_json.packs_online, 'packs_configured': value_json.packs_configured} | tojson }}",
      "name": "Problem",
      "p": "binary_sensor",
      "uniq_id": "felicity_system_problem",
      "val_tpl": "{{ 'ON' if value_json.problem else 'OFF' }}"
    },
    "felicity_system_remaining_ah": {
      "ic": "mdi:battery-medium",
      "name": "Remaining capacity",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_remaining_ah",
      "unit_of_meas": "Ah",
      "val_tpl": "{{ value_json.remaining_ah }}"
    },
    "felicity_system_soc": {
      "dev_cla": "battery",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'packs_online': value_json.packs_online, 'packs_configured': value_json.packs_configured, 'last_update': value_json.last_update} | tojson }}",
      "name": "State of charge",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 0,
      "uniq_id": "felicity_system_soc",
      "unit_of_meas": "%",
      "val_tpl": "{{ value_json.soc }}"
    },
    "felicity_system_stored_energy": {
      "dev_cla": "energy_storage",
      "name": "Stored energy",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 2,
      "uniq_id": "felicity_system_stored_energy",
      "unit_of_meas": "kWh",
      "val_tpl": "{{ value_json.stored_kwh }}"
    },
    "felicity_system_temperature": {
      "dev_cla": "temperature",
      "name": "Temperature",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_temperature",
      "unit_of_meas": "°C",
      "val_tpl": "{{ value_json.temperature }}"
    },
    "felicity_system_temperature_max": {
      "dev_cla": "temperature",
      "json_attr_t": "felicity/system/state",
      "json_attr_tpl": "{{ {'pack': value_json.temperature_max_pack, 'sensor': value_json.temperature_max_sensor} | tojson }}",
      "name": "Temperature max",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 1,
      "uniq_id": "felicity_system_temperature_max",
      "unit_of_meas": "°C",
      "val_tpl": "{{ value_json.temperature_max }}"
    },
    "felicity_system_voltage": {
      "dev_cla": "voltage",
      "name": "Voltage",
      "p": "sensor",
      "stat_cla": "measurement",
      "sug_dsp_prc": 2,
      "uniq_id": "felicity_system_voltage",
      "unit_of_meas": "V",
      "val_tpl": "{{ value_json.voltage }}"
    }
  },
  "dev": {
    "ids": [
      "felicity_system"
    ],
    "mdl": "3× FLB48314TG1",
    "mf": "Felicity Solar",
    "name": "Felicity Battery System"
  },
  "o": {
    "name": "felicityd",
    "sw": "test",
    "url": "https://example.invalid"
  },
  "qos": 0,
  "stat_t": "felicity/system/state"
}
