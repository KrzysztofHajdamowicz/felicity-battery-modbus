# felicityd configuration - copy to /etc/default/felicityd (systemd EnvironmentFile).
# Every variable is optional unless marked required. Durations use Go syntax: 500ms, 5s, 2m.

# --- RS485 bus -------------------------------------------------------------------------------
# Serial device of the USB-RS485 adapter. Prefer the stable by-id path on a Raspberry Pi:
#   ls -l /dev/serial/by-id/
FELICITYD_SERIAL_PORT=/dev/ttyUSB0
# Pack addresses (DIP switches), comma separated. Leave empty to enumerate 1, 2, 3, ... until the
# first address that does not answer (docs/protocol.md §6).
#FELICITYD_PACK_ADDRESSES=1,2,3
# Highest address tried during enumeration.
#FELICITYD_MAX_ADDRESS=16
# Polling intervals per pack (docs/protocol.md §8).
#FELICITYD_STATUS_INTERVAL=5s        # registers 37..53: temperatures, current, voltage, SOC
#FELICITYD_CELLS_INTERVAL=30s        # registers 16..36: cell voltages
#FELICITYD_LIMITS_INTERVAL=60s       # registers 112..116: charge/discharge limits and status bits
#FELICITYD_ALARMS_INTERVAL=30s       # registers 54..60, only if the pack implements them
#FELICITYD_OFFLINE_INTERVAL=30s      # retry period for a pack that stopped answering
# Minimum pause between frames and response timeout.
#FELICITYD_BUS_GAP=200ms
#FELICITYD_BUS_TIMEOUT=500ms
# Consecutive failed status reads before a pack is reported offline.
#FELICITYD_OFFLINE_AFTER=5
# Accept responses whose final CRC byte was lost on the wire when the CRC low byte matches
# (1 in 256 chance of accepting a corrupted frame). Frames missing the address byte are always
# repaired because the full CRC still verifies. See docs/protocol.md §3.
#FELICITYD_ACCEPT_TRUNCATED_CRC=false

# --- MQTT ----------------------------------------------------------------------------------------
FELICITYD_MQTT_HOST=homeassistant.local            # required
#FELICITYD_MQTT_PORT=1883                           # default 1883, or 8883 with TLS
#FELICITYD_MQTT_TLS=false
#FELICITYD_MQTT_TLS_INSECURE=false                  # skip certificate verification
#FELICITYD_MQTT_CA_FILE=/etc/ssl/certs/my-ca.pem    # custom CA for the broker certificate
FELICITYD_MQTT_USERNAME=
FELICITYD_MQTT_PASSWORD=
#FELICITYD_MQTT_CLIENT_ID=felicityd-<hostname>
# Base of the state topics: <prefix>/availability, <prefix>/pack/<n>/state, <prefix>/system/state
#FELICITYD_MQTT_TOPIC_PREFIX=felicity

# --- Home Assistant ------------------------------------------------------------------------------
FELICITYD_HA_DISCOVERY=true
#FELICITYD_HA_DISCOVERY_PREFIX=homeassistant
# Prefix of every unique_id and device identifier. Change it if you run two buses.
#FELICITYD_SYSTEM_ID=felicity
# Device names: "<name> 1", "<name> 2", ..., "<name> System"
#FELICITYD_DEVICE_NAME=Felicity Battery
#FELICITYD_MANUFACTURER=Felicity Solar
# Model shown in the device registry (the protocol does not expose it).
#FELICITYD_PACK_MODEL=FLB48314TG1
# Nominal pack voltage for the "Stored energy" estimate (16S LiFePO4 = 51.2 V).
#FELICITYD_NOMINAL_VOLTAGE=51.2

# --- Logging -------------------------------------------------------------------------------------
#FELICITYD_LOG_LEVEL=info                           # debug | info | warn | error
